# Copy to backend/.env for running the backend outside Docker.
# docker-compose.yml already sets these for local development.

# Database
DB_HOST=database
DB_PORT=3306
DB_USER=uxco_user
DB_PASSWORD=uxco_password
DB_NAME=uxco_db

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins in production (leave empty in dev)
CORS_ORIGINS=

# Admin authentication (single Google account)
# 1. Create an OAuth 2.0 Client ID (type: Web application) at https://console.cloud.google.com/apis/credentials
# 2. Add your site origin (e.g. http://localhost:3000) under "Authorized JavaScript origins"
# 3. Paste the Client ID below and set ADMIN_EMAIL to the club's Google account
GOOGLE_CLIENT_ID=
ADMIN_EMAIL=
# Long random string used to sign admin session cookies (required in production)
SESSION_SECRET=
# Local-only "Continue as dev admin" button while Google is not configured. Always off when NODE_ENV=production.
ALLOW_DEV_LOGIN=true
